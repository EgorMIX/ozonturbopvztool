{
  "manifest_version": 3,
  "name": "Ozon Turbo-PVZ Timer",
  "version": "1.4.0",
  "description": "Уведомление до истечения таймера приёмки на Ozon Turbo-PVZ",
  "permissions": [
    "notifications",
    "alarms",
    "storage",
    "scripting",
    "proxy",
    "webRequest",
    "webRequestAuthProvider"
  ],
  "host_permissions": [
    "*://turbo-pvz.ozon.ru/*",
    "*://api.telegram.org/*",
    "*://ntfy.sh/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://turbo-pvz.ozon.ru/*"
      ],
      "js": [
        "content.js",
        "speech.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://turbo-pvz.ozon.ru/*"
      ],
      "js": [
        "bags-content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "speech.js"
      ],
      "matches": [
        "*://turbo-pvz.ozon.ru/*"
      ]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}